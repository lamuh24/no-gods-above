{
  "toolName": "SpriteForge Agent",
  "schemaVersion": "1.0.0",
  "assetRoot": "../../assets/characters",
  "approvalPolicies": {
    "conservative": {
      "autoApprovePreview": false,
      "autoApproveLive": false,
      "requireHumanReviewEveryClip": true
    },
    "previewAuto": {
      "autoApprovePreview": true,
      "autoApproveLive": false,
      "requireHumanReviewEveryClip": false,
      "maxRetriesPerClip": 3,
      "minTechnicalStatus": "pass",
      "minVisualScore": 85,
      "requireSmokeTestPass": true,
      "quarantineSuspiciousOutputs": true
    },
    "fullAutoPreview": {
      "autoApprovePreview": true,
      "autoApproveLive": false,
      "requireHumanReviewEveryClip": false,
      "maxRetriesPerClip": 5,
      "minTechnicalStatus": "pass",
      "minVisualScore": 90,
      "requireSmokeTestPass": true,
      "quarantineSuspiciousOutputs": true
    }
  },
  "providers": {
    "active": "manual",
    "manual": {
      "mode": "outbox",
      "promptOutbox": "prompts/outbox",
      "generatedInbox": "generated/inbox"
    },
    "spritebuilder": {
      "mode": "local",
      "command": "<configure command here>",
      "executable": "npm.cmd",
      "args": ["--prefix", "tools/spritebuilder", "run", "generate", "--", "--request", "<requestPath>", "--write-dev-png"],
      "inputPromptPath": true,
      "outputDirectory": "assets/characters/<character>/generated/provider_review/spritebuilder/<clip>/<timestamp>/",
      "requestPath": "assets/characters/<character>/generated/provider_review/spritebuilder/<clip>/<timestamp>/spritebuilder_request.json",
      "timeoutMs": 600000
    }
  },
  "provider": {
    "active": "manual",
    "manual": {
      "promptOutbox": "prompts/outbox",
      "generatedInbox": "generated/inbox"
    }
  },
  "sprite": {
    "frameWidth": 448,
    "frameHeight": 448,
    "baselineY": 382,
    "facing": "right",
    "anchorX": 224,
    "safeBox": {
      "maxWidth": 336,
      "maxHeight": 352,
      "minHeight": 180
    },
    "allowScaleUp": false
  },
  "validation": {
    "maxBaselineDriftPx": 8,
    "maxCenterDriftPx": 24,
    "maxScaleDriftPx": 34,
    "cropMarginPx": 4,
    "minOpaquePixels": 1200,
    "alphaOpaqueThreshold": 24,
    "opaqueBackgroundRatio": 0.96,
    "edgeBorderOpaqueRatio": 0.78,
    "solidBackgroundColorDistance": 28,
    "duplicateHashMaxDistance": 4
  },
  "clipDefaults": {
    "frameCount": 6,
    "fps": 12,
    "loop": false,
    "category": "movement"
  },
  "clips": {
    "idle": { "category": "movement", "frameCount": 8, "fps": 8, "loop": true },
    "neutral_light": { "category": "normal", "frameCount": 6, "fps": 14 },
    "hit_stun": { "category": "damage", "frameCount": 4, "fps": 10 },
    "block": { "category": "defense", "frameCount": 4, "fps": 10 },
    "jump": { "category": "movement", "frameCount": 6, "fps": 12 },
    "crouch": {
      "category": "movement",
      "frameCount": 8,
      "fps": 8,
      "loop": true,
      "notes": [
        "Generate Sable only as a loopable crouch idle / crouching guard.",
        "Use a readable lower fighting stance with subtle breathing motion.",
        "Keep character scale stable and full body visible in every 448x448 frame.",
        "Use restrained silver/black void fracture energy around the forearms only.",
        "Use transparent alpha only; no green screen, no chroma background, no flat-color background."
      ]
    },
    "walk_forward": { "category": "movement", "frameCount": 8, "fps": 10, "loop": true },
    "walk_backward": { "category": "movement", "frameCount": 8, "fps": 10, "loop": true },
    "dash_forward": { "category": "movement", "frameCount": 6, "fps": 16 },
    "dash_backward": { "category": "movement", "frameCount": 6, "fps": 16 },
    "jump_start": { "category": "movement", "frameCount": 4, "fps": 14 },
    "jump_loop": { "category": "movement", "frameCount": 4, "fps": 10, "loop": true },
    "fall": { "category": "movement", "frameCount": 4, "fps": 10, "loop": true },
    "land": { "category": "movement", "frameCount": 4, "fps": 12 },
    "knockdown": { "category": "damage", "frameCount": 6, "fps": 10 },
    "getup": { "category": "damage", "frameCount": 6, "fps": 10 },
    "stand_light": { "category": "normal", "frameCount": 6, "fps": 14, "hitFrames": [2] },
    "stand_medium": { "category": "normal", "frameCount": 6, "fps": 13, "hitFrames": [3] },
    "stand_heavy": { "category": "normal", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "crouch_light": {
      "category": "normal",
      "frameCount": 6,
      "fps": 14,
      "hitFrames": [2],
      "notes": [
        "Low crouching light poke from Sable's crouch stance.",
        "Keep the strike compact and body-first, with only tiny attached void-crystal accents.",
        "Do not turn this into Ground Rift or any large ground VFX."
      ]
    },
    "crouch_medium": {
      "category": "normal",
      "frameCount": 6,
      "fps": 13,
      "hitFrames": [3],
      "notes": [
        "Low crouching medium strike with a longer arm or leg reach than crouch_light.",
        "Keep Sable grounded, low, and readable in every frame.",
        "Do not add detached shard debris or a full special-effect burst."
      ]
    },
    "crouch_heavy": {
      "category": "normal",
      "frameCount": 8,
      "fps": 12,
      "hitFrames": [4],
      "notes": [
        "Heavy crouching normal / low sweep-like body attack.",
        "This is a normal attack, not Ground Rift; use compact impact accents only.",
        "Keep the body scale stable and avoid clipping feet, hands, hair, or crystal wraps."
      ]
    },
    "jump_light": { "category": "normal", "frameCount": 6, "fps": 14, "hitFrames": [2] },
    "jump_medium": { "category": "normal", "frameCount": 6, "fps": 13, "hitFrames": [3] },
    "jump_heavy": { "category": "normal", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "forward_light": {
      "category": "normal",
      "frameCount": 6,
      "fps": 14,
      "hitFrames": [2],
      "notes": [
        "Forward-moving light normal, a compact advancing palm or forearm check.",
        "This is not Phase Lunge; keep travel implied by pose only and avoid special VFX.",
        "Maintain Sable's locked pixel style and in-frame body silhouette."
      ]
    },
    "forward_medium": {
      "category": "normal",
      "frameCount": 6,
      "fps": 13,
      "hitFrames": [3],
      "notes": [
        "Forward-moving medium normal with more commitment than forward_light.",
        "Use compact crystal accents attached to the attacking arm only.",
        "Do not make this a special lunge, projectile, or teleport."
      ]
    },
    "forward_heavy": {
      "category": "normal",
      "frameCount": 8,
      "fps": 12,
      "hitFrames": [4],
      "notes": [
        "Forward-moving heavy normal, broad body-first strike with strong silhouette.",
        "This is not Forward Heavy Phase Lunge; avoid long travel, portals, or big detached VFX.",
        "Keep all frames contained inside the 448x448 cells."
      ]
    },
    "back_light": {
      "category": "normal",
      "frameCount": 6,
      "fps": 14,
      "hitFrames": [2],
      "notes": [
        "Retreating defensive light normal / quick back-step guard check.",
        "This is not Void Anchor; do not create a trap, anchor crystal, or ground portal.",
        "Keep the effect compact and attached to Sable's forearm."
      ]
    },
    "back_medium": {
      "category": "normal",
      "frameCount": 6,
      "fps": 13,
      "hitFrames": [3],
      "notes": [
        "Retreating medium normal with a defensive counter-poke feel.",
        "Keep Sable facing the opponent while shifting weight backward.",
        "No trap placement, no detached anchor, and no large VFX."
      ]
    },
    "back_heavy": {
      "category": "normal",
      "frameCount": 8,
      "fps": 12,
      "hitFrames": [4],
      "notes": [
        "Heavy back normal / defensive launcher-like body strike.",
        "This is a normal attack, not Void Anchor; no trap or special object.",
        "Keep Sable's body readable, grounded, and consistently scaled."
      ]
    },
    "neutral_special_light": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "neutral_special_medium": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "neutral_special_heavy": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [5] },
    "forward_special_light": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "forward_special_medium": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "forward_special_heavy": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [5] },
    "back_special_light": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "back_special_medium": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "back_special_heavy": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [5] },
    "up_special_light": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "up_special_medium": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "up_special_heavy": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [5] },
    "down_special_light": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "down_special_medium": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [4] },
    "down_special_heavy": { "category": "special", "frameCount": 8, "fps": 12, "hitFrames": [5] },
    "ultimate_start": { "category": "ultimate", "frameCount": 8, "fps": 10 },
    "ultimate_fire": { "category": "ultimate", "frameCount": 8, "fps": 10, "hitFrames": [5] },
    "taunt": { "category": "cinematic", "frameCount": 8, "fps": 8 }
  },
