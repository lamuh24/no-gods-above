# Local deploy/config output
.netlify/

# Local agent/temp workspace state
.claude/
tmp/

# Node package output
**/node_modules/
**/dist/

# Python generated bytecode
**/__pycache__/
*.py[cod]

# Browser/profile output from smoke and validation runs
**/chrome-profile/
**/tmp-prof*/
**/GPUCache/
**/ShaderCache/
**/BrowserMetrics/
**/Crashpad/
NO_GODS_ABOVE/assets/**/validation/**/chrome-profile/
NO_GODS_ABOVE/assets/**/validation/**/tmp-prof*/

# SpriteForge provider test output
assets/characters/*/generated/provider_review/
assets/characters/*/generated/quarantine/
assets/characters/*/reports/spritebuilder_dry_run/

# Steam/Electron build output
node_modules/
steam/desktop/node_modules/
steam/desktop/dist/
steam/desktop/release/
steam/content/
steam/steampipe/generated/
steam/steampipe/output/
steam_release/content/NoGodsAbove/
steam_release/scripts/generated/
steam_release/scripts/output/

# Root-level generated screenshots. Final assets should live under assets/.
NO_GODS_ABOVE/*.png
NO_GODS_ABOVE/rollback_*.png
NO_GODS_ABOVE/*_smoke.png
NO_GODS_ABOVE/*_preview*.png

# Raw AI-generation intermediates (candidate dumps, rejected art). Approved
# outputs are synced into NO_GODS_ABOVE/assets and pipeline manifests/reports.
assets/characters/**/generated/inbox/
assets/characters/**/generated/quarantine/

# Engine V2 Vite build output (`**/dist/` and `**/node_modules/` are covered above)
NO_GODS_ABOVE/engine_v2/debug_dist/
