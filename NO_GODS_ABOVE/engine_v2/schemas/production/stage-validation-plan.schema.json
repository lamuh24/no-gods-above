{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://no-gods-above.local/schemas/production/stage-validation-plan.schema.json",
  "title": "NGA Production Stage Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "arenaId", "status", "deployable", "approvalState", "globalAssertions", "scenarios", "deviceMatrix", "capturePolicy", "approvalGate"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-stage-validation-plan" },
    "arenaId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "status": { "enum": ["production_arena_brief_candidate", "production_arena_graybox_candidate"] },
    "deployable": { "const": false },
    "approvalState": { "enum": ["awaiting_human_stage_brief_approval", "awaiting_human_graybox_and_concept_approval"] },
    "globalAssertions": { "type": "array", "minItems": 8, "items": { "type": "string" }, "uniqueItems": true },
    "scenarios": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "setup", "assertions", "captures", "rollbackRequired"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "setup": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "assertions": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "captures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rollbackRequired": { "type": "boolean" }
        }
      }
    },
    "deviceMatrix": { "type": "array", "minItems": 4, "items": { "type": "object", "required": ["browser", "gpuClass", "resolution", "targetFps"] } },
    "capturePolicy": { "type": "object", "required": ["deterministicEnvironmentMotion", "overlayPair", "naming", "report"] },
    "approvalGate": { "enum": ["human_stage_brief_and_validation_plan_approval_required_before_art_production", "human_graybox_and_concept_approval_required_before_final_art_production"] }
  }
}
