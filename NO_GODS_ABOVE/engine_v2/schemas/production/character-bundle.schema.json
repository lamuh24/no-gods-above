{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://no-gods-above.local/schemas/production/character-bundle.schema.json",
  "title": "NGA Character Production Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "bundleVersion", "promotionState", "runtimeProfile", "design", "poseLibrary", "animationPackages", "packageGroups"],
  "properties": {
    "schemaVersion": { "const": "2.1.0-contract" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "bundleVersion": { "type": "integer", "minimum": 1 },
    "promotionState": { "enum": ["draft", "candidate", "approved", "retired"] },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldHeight", "centerline", "footPosition", "handReach", "universalCapabilities"],
      "properties": {
        "worldHeight": { "type": "integer", "minimum": 1 },
        "centerline": { "type": "integer" },
        "footPosition": { "type": "integer" },
        "handReach": { "type": "integer", "minimum": 1 },
        "universalCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterBible", "palette", "forbiddenMutations"],
      "properties": {
        "characterBible": { "type": "string", "minLength": 1 },
        "palette": { "type": "string", "minLength": 1 },
        "forbiddenMutations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "poseLibrary": { "type": "array", "minItems": 1, "items": { "$ref": "pose-token.schema.json" } },
    "animationPackages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "packageGroups": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
    }
  }
}
